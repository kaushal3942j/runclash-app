# RunClash Supabase Configuration Template
# Copy this file to '.env.local' and fill in your details

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: CARTO API Key for vector maps. If omitted, uses public endpoint (rate limited).
VITE_CARTO_API_KEY=your_carto_api_key_here
